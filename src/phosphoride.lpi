<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="None"/>
      <Title Value="PhosphorIDE"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
      <Item Name="Release">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="../bin/phosphoride"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <OtherUnitFiles Value="core"/>
            <UnitOutputDirectory Value="../lib/$(TargetCPU)-$(TargetOS)-release"/>
          </SearchPaths>
          <CodeGeneration>
            <SmartLinkUnit Value="True"/>
            <Optimizations>
              <OptimizationLevel Value="3"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="False"/>
              <StripSymbols Value="True"/>
            </Debugging>
            <LinkSmart Value="True"/>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-vewn"/>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="phosphoride.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="umainform.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrmMain"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="umainform"/>
      </Unit>
      <Unit>
        <Filename Value="uaboutform.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrmAbout"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="uaboutform"/>
      </Unit>
      <Unit>
        <Filename Value="upreferencesform.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrmPreferences"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="upreferencesform"/>
      </Unit>
      <Unit>
        <Filename Value="core/uphosphorlang.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uphosphorlang"/>
      </Unit>
      <Unit>
        <Filename Value="core/uphosphormsg.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uphosphormsg"/>
      </Unit>
      <Unit>
        <Filename Value="core/uphosphorhost.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uphosphorhost"/>
      </Unit>
      <Unit>
        <Filename Value="core/uphosphorsettings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uphosphorsettings"/>
      </Unit>
      <Unit>
        <Filename Value="core/uphosphorrun.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uphosphorrun"/>
      </Unit>
      <Unit>
        <Filename Value="core/ubreakpoints.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ubreakpoints"/>
      </Unit>
      <Unit>
        <Filename Value="core/ueditordoc.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ueditordoc"/>
      </Unit>
      <Unit>
        <Filename Value="core/usynphosphor.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="usynphosphor"/>
      </Unit>
      <Unit>
        <Filename Value="core/udebugproto.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="udebugproto"/>
      </Unit>
      <Unit>
        <Filename Value="core/udebugsession.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="udebugsession"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/phosphoride"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="core"/>
      <UnitOutputDirectory Value="../lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <IncludeAssertionCode Value="True"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-vewn"/>
    </Other>
  </CompilerOptions>
</CONFIG>
